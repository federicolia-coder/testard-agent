#!/bin/sh
# testard-agent: reports this server's health to Testard once a minute.
#
# What it sends: hostname, OS, CPU count, memory and disk size, uptime, and
# CPU / memory / disk usage and network throughput. Nothing else.
# What it never does: receive or run commands. Testard can't control this
# server through the agent; the key only lets it submit reports.
#
# Usage:
#   testard-agent run         collect and send one report (the timer does this)
#   testard-agent status      show the configuration and the last result
#   testard-agent uninstall   remove the agent, its timer and its files
#   testard-agent version

set -eu

VERSION="1.0.0"
CONF="${TESTARD_AGENT_CONF:-/etc/testard-agent/agent.conf}"
HEADER="${TESTARD_AGENT_HEADER:-/etc/testard-agent/auth-header}"
STATE_DIR="${TESTARD_AGENT_STATE:-/var/lib/testard-agent}"

die() { echo "testard-agent: $*" >&2; exit 1; }

# Reads KEY=value lines without executing the file.
conf_get() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | head -n 1; }

# JSON string: escapes backslashes and quotes, drops control characters.
json_str() { printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

cpu_times() { awk '/^cpu /{ idle=$5+$6; total=0; for (i=2;i<=NF;i++) total+=$i; print total, idle; exit }' /proc/stat; }

net_bytes() {
  # Sum of all interfaces except loopback: received and transmitted bytes.
  awk 'NR>2 { gsub(/:/, " "); if ($1 != "lo") { rx += $2; tx += $10 } } END { printf "%.0f %.0f\n", rx, tx }' /proc/net/dev
}

collect() {
  set -- $(cpu_times); t1=$1; i1=$2
  sleep 1
  set -- $(cpu_times); t2=$1; i2=$2
  cpu=$(awk -v t1="$t1" -v i1="$i1" -v t2="$t2" -v i2="$i2" 'BEGIN { dt=t2-t1; printf "%.1f", (dt > 0 ? (1 - (i2-i1)/dt) * 100 : 0) }')

  mem_total=$(awk '/^MemTotal:/{ print $2 * 1024; exit }' /proc/meminfo)
  mem_avail=$(awk '/^MemAvailable:/{ print $2 * 1024; exit }' /proc/meminfo)
  mem_pct=$(awk -v t="$mem_total" -v a="$mem_avail" 'BEGIN { printf "%.1f", (t > 0 ? (t - a) / t * 100 : 0) }')

  set -- $(df -Pk / | awk 'NR==2 { print $2 * 1024, $3 * 1024 }')
  disk_total=$1; disk_used=$2
  disk_pct=$(awk -v t="$disk_total" -v u="$disk_used" 'BEGIN { printf "%.1f", (t > 0 ? u / t * 100 : 0) }')

  # Network throughput since the previous run.
  now=$(date +%s)
  set -- $(net_bytes); rx=$1; tx=$2
  rx_rate=0; tx_rate=0
  if [ -r "$STATE_DIR/net" ]; then
    read -r prev_t prev_rx prev_tx < "$STATE_DIR/net" || true
    if [ -n "${prev_t:-}" ] && [ "$now" -gt "$prev_t" ]; then
      rx_rate=$(awk -v a="$rx" -v b="$prev_rx" -v s=$((now - prev_t)) 'BEGIN { r=(a-b)/s; printf "%.0f", (r > 0 ? r : 0) }')
      tx_rate=$(awk -v a="$tx" -v b="$prev_tx" -v s=$((now - prev_t)) 'BEGIN { r=(a-b)/s; printf "%.0f", (r > 0 ? r : 0) }')
    fi
  fi
  echo "$now $rx $tx" > "$STATE_DIR/net"

  cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || grep -c '^processor' /proc/cpuinfo)
  uptime=$(awk '{ printf "%.0f", $1 }' /proc/uptime)
  load1=$(awk '{ print $1 }' /proc/loadavg)
  host=$(cat /proc/sys/kernel/hostname 2>/dev/null || hostname)
  os=$( (. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-Linux}") || printf 'Linux')
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i=1;i<NF;i++) if ($i=="src") { print $(i+1); exit } }' || true)
  [ -n "$ip" ] || ip=$(hostname -I 2>/dev/null | awk '{ print $1 }' || true)

  printf '{"version":1,"agentVersion":"%s","hostname":"%s","os":"%s","kernel":"%s","arch":"%s","cpus":%s,"memoryBytes":%s,"diskBytes":%s,"uptimeSeconds":%s,"cpuPercent":%s,"memoryPercent":%s,"diskPercent":%s,"netInBytesPerSec":%s,"netOutBytesPerSec":%s,"load1":%s%s}\n' \
    "$VERSION" "$(json_str "$host")" "$(json_str "$os")" "$(json_str "$(uname -r)")" "$(json_str "$(uname -m)")" \
    "$cpus" "$mem_total" "$disk_total" "$uptime" "$cpu" "$mem_pct" "$disk_pct" "$rx_rate" "$tx_rate" "$load1" \
    "$( [ -n "$ip" ] && printf ',"privateIp":"%s"' "$(json_str "$ip")" )"
}

run() {
  url=$(conf_get TESTARD_URL)
  [ -n "$url" ] || die "no TESTARD_URL in $CONF"
  [ -r "$HEADER" ] || die "can't read $HEADER"
  mkdir -p "$STATE_DIR"
  # The key travels in a header file, so it never appears in the process list.
  result=$(collect | curl -sS -m 20 -o - -w ' %{http_code}' -X POST \
    -H @"$HEADER" -H 'Content-Type: application/json' -H "User-Agent: testard-agent/$VERSION" \
    --data-binary @- "$url/api/agent/v1/report" 2>&1) || true
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$result" > "$STATE_DIR/last"
  case "$result" in
    *' 202') ;;
    *' 429') ;; # reported less than 20 seconds ago; harmless
    *) die "report failed: $result" ;;
  esac
}

status() {
  echo "testard-agent $VERSION"
  echo "reports to: $(conf_get TESTARD_URL)"
  if [ -r "$STATE_DIR/last" ]; then echo "last run:   $(cat "$STATE_DIR/last")"; else echo "last run:   never"; fi
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files testard-agent.timer >/dev/null 2>&1; then
    echo "timer:      $(systemctl is-active testard-agent.timer 2>/dev/null || true)"
  fi
}

uninstall() {
  [ "$(id -u)" -eq 0 ] || die "run uninstall as root (sudo testard-agent uninstall)"
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now testard-agent.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/testard-agent.service /etc/systemd/system/testard-agent.timer
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
  rm -f /etc/cron.d/testard-agent
  rm -rf /etc/testard-agent "$STATE_DIR"
  id testard-agent >/dev/null 2>&1 && userdel testard-agent >/dev/null 2>&1 || true
  rm -f /usr/local/bin/testard-agent
  echo "testard-agent removed. Delete the server in Testard to remove its history too."
}

case "${1:-run}" in
  run) run ;;
  collect) collect ;;
  status) status ;;
  uninstall) uninstall ;;
  version) echo "$VERSION" ;;
  *) die "unknown command: $1 (use run, status, uninstall or version)" ;;
esac
